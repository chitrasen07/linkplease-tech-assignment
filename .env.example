# Copy to .env and fill in. NEVER commit the real .env.

# --- PseudoGram ------------------------------------------------------------
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com
# Get one from POST /v1/keygen (see README "Getting a PseudoGram API key")
PSEUDOGRAM_API_KEY=
PSEUDOGRAM_TIMEOUT_SECONDS=15

# --- Storage ---------------------------------------------------------------
# SQLite for local/single-instance. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/linkplease
DATABASE_URL=sqlite:///./linkplease.db

# --- Webhook security ------------------------------------------------------
# true in production. Set to false locally when sending unsigned test webhooks.
VERIFY_WEBHOOK_SIGNATURE=true
# Defaults to PSEUDOGRAM_API_KEY; only set if the sender signs with another key.
WEBHOOK_SIGNING_SECRET=
MAX_WEBHOOK_BODY_BYTES=65536

# --- Delivery policy -------------------------------------------------------
# Consecutive transient send failures (500/timeout) before giving up. Reset by
# a 202, so this bounds continuous outages, not lifetime bad luck.
MAX_DM_ATTEMPTS=5
# Confirmed delivery failures (GET /v1/dm/{id} -> failed) before giving up.
MAX_DELIVERY_ATTEMPTS=5
RETRY_BASE_SECONDS=1.0
RETRY_JITTER_RATIO=0.25
RETRY_MAX_BACKOFF_SECONDS=300
AUTH_ERROR_PAUSE_SECONDS=60

# --- Workers ---------------------------------------------------------------
ENABLE_WORKERS=true
WORKER_POLL_INTERVAL_SECONDS=1
EVENT_POLL_INTERVAL_SECONDS=0.2
DELIVERY_POLL_INTERVAL_SECONDS=5
SENDING_STALE_SECONDS=120

# --- PseudoGram send rate limit (10 per rolling 60s) -----------------------
SEND_RATE_LIMIT_MAX_CALLS=10
SEND_RATE_LIMIT_WINDOW_SECONDS=60
SEND_RATE_LIMIT_SAFETY_SECONDS=0.5

# --- Stats semantics -------------------------------------------------------
# false: count only blocked DM-job insertions (the assignment's wording).
# true : also count redelivered matching webhooks. See README.
COUNT_DUPLICATE_EVENTS_AS_BLOCKED=false

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
